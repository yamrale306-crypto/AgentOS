{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentOS",
  "version": "1.0.0",
  "identifier": "com.agentos.app",
  "build": { "frontendDist": "../../frontend/out", "beforeBuildCommand": "npm run build:web" },
  "app": { "windows": [{ "title": "AgentOS", "width": 1280, "height": 820, "minWidth": 400, "minHeight": 600 }] },
  "bundle": { "active": true, "targets": ["nsis", "msi"], "windows": { "nsis": { "installerMode": "currentUser" } } },
  "plugins": {
    "updater": { "active": false, "dialog": false, "pubkey": "", "endpoints": [] }
  }
}

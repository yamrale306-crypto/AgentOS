{
  "name": "agentos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint && eslint scripts --max-warnings 0",
    "import:keys": "tsx scripts/import-keys.ts",
    "verify:providers": "tsx scripts/verify-providers.ts"
  },
  "devDependencies": {
    "@agentos/ai": "workspace:*",
    "@agentos/config": "workspace:*",
    "@types/node": "^24.3.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.20.5",
    "turbo": "^2.5.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0"
  }
}
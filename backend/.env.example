# --- AgentOS backend environment -------------------------------------------
# Copy this file to .env and fill in real values. NEVER commit .env.

NODE_ENV=development

# HTTP port the backend listens on.
PORT=10000

# Comma-separated list of allowed browser origins for CORS.
FRONTEND_ORIGIN=http://localhost:3000

# Public URL of the frontend (used as the OpenRouter referer header).
APP_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Project URL from Supabase Dashboard > Project Settings > API.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Service role key. SERVER-SIDE ONLY. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- AI providers (at least one required; all optional individually) -------
# Tokens are SERVER-SIDE ONLY. For multiple tokens per provider use the
# *_API_KEYS form with comma-separated values (the router rotates between them).

# OpenRouter
OPENROUTER_API_KEY=
# Primary/fallback model ids for LEGACY single-provider mode only
# (AI_ROUTING_ENABLED=false). In AUTO routing mode the router selects from the
# verified catalog, so these are not required.
# OPENROUTER_MODEL_PRIMARY=openrouter/free
# OPENROUTER_MODEL_FALLBACK=google/gemma-4-26b-a4b-it:free

# DeepSeek (https://api.deepseek.com)
DEEPSEEK_API_KEY=
# DEEPSEEK_API_KEYS=key1,key2

# Groq (https://api.groq.com)
GROQ_API_KEY=
# GROQ_API_KEYS=key1,key2

# Google Gemini (https://ai.google.dev) — OpenAI-compatible endpoint
GEMINI_API_KEY=
# GEMINI_API_KEYS=key1,key2

# Z.ai (https://z.ai)
ZAI_API_KEY=
# ZAI_API_KEYS=key1,key2

# Cloudflare Workers AI — needs BOTH account id and API token
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# --- Routing / model selection ----------------------------------------------
# AUTO uses the smart router. Other options: QUALITY, FAST, BALANCED, LOW COST.
AI_DEFAULT_MODE=auto
# Optional global default model override (e.g. "deepseek/deepseek-chat").
AI_DEFAULT_MODEL=
# Set false to disable smart routing and use the OpenRouter primary/fallback pair.
AI_ROUTING_ENABLED=true
# Bounded fallback attempts across providers/models/tokens before failing.
MAX_MODEL_ATTEMPTS=6

# --- Limits -----------------------------------------------------------------
# Hard safety limits for a single research run.
MAX_STEPS=8
MAX_SEARCHES=5
# Per-user daily quotas (enforced atomically in PostgreSQL).
DAILY_TASK_LIMIT=10
DAILY_SEARCH_LIMIT=50
# Maximum simultaneously active (queued/planning/searching/analyzing/verifying)
# tasks a single user may have.
MAX_ACTIVE_TASKS_PER_USER=2

# --- Runtime ----------------------------------------------------------------
# AI request timeout in milliseconds before falling back to the next model/token.
MODEL_TIMEOUT_MS=90000
# debug | info | warn | error
LOG_LEVEL=info
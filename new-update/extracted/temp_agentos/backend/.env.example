# --- AgentOS backend environment -------------------------------------------
# Copy this file to .env and fill in real values.

NODE_ENV=development

# HTTP port the backend listens on.
PORT=10000

# Comma-separated list of allowed browser origins for CORS.
FRONTEND_ORIGIN=http://localhost:3000

# Public URL of the frontend (used as the OpenRouter referer header).
APP_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Project URL from Supabase Dashboard > Project Settings > API.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Service role key. SERVER-SIDE ONLY. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- OpenRouter -------------------------------------------------------------
# API key from https://openrouter.ai/keys. NEVER expose to the browser.
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
# Primary model id. Verify availability on the OpenRouter dashboard.
OPENROUTER_MODEL_PRIMARY=openrouter/free
# Fallback model id used when the primary fails or times out.
OPENROUTER_MODEL_FALLBACK=google/gemma-4-26b-a4b-it:free

# --- Limits -----------------------------------------------------------------
# Hard safety limits for a single research run.
MAX_STEPS=8
MAX_SEARCHES=5
# Per-user daily quotas (enforced atomically in PostgreSQL).
DAILY_TASK_LIMIT=10
DAILY_SEARCH_LIMIT=50
# Maximum simultaneously active (queued/planning/searching/analyzing/verifying)
# tasks a single user may have.
MAX_ACTIVE_TASKS_PER_USER=2

# --- Runtime ----------------------------------------------------------------
# AI request timeout in milliseconds before falling back to the next model.
MODEL_TIMEOUT_MS=90000
# debug | info | warn | error
LOG_LEVEL=info
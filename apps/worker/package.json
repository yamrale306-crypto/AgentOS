{
  "name": "@agentos/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentos/ai": "workspace:*",
    "@agentos/config": "workspace:*",
    "@agentos/database": "workspace:*",
    "@agentos/runtime": "workspace:*",
    "@agentos/schemas": "workspace:*",
    "@agentos/tools": "workspace:*",
    "openai": "^6.7.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}